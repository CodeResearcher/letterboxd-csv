# Copy to `.env.local` and fill in what you need. `.env.local` is gitignored.
#
# Only VITE_TMDB_API_KEY is mandatory. Everything else is optional and can also
# be entered in the app's Settings screen instead.

# --- mandatory -------------------------------------------------------------
# Get a key at https://www.themoviedb.org/settings/api
# Ships in the published bundle and is readable by any visitor.
VITE_TMDB_API_KEY=

# --- optional --------------------------------------------------------------
# Overrides the built-in CORS proxy (see README > CORS proxy). The app ships
# with a working default, so leave this blank unless you deployed your own
# Worker. Public, so safe to share.
VITE_CORS_PROXY_URL=

# Barcode-database keys are OPTIONAL and for local testing only: they are read
# only while `import.meta.env.DEV` is true, so a production build never bundles
# them. Blank is fine — enter keys in Settings instead, or rely on UPCitemdb's
# keyless trial endpoint.
VITE_UPCMDB_API_KEY=
VITE_UPCDATABASE_API_KEY=
VITE_EANDATA_API_KEY=
VITE_UPCITEMDB_API_KEY=
