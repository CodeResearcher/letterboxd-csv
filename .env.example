# Copy to `.env.local` and fill in what you need.
#
# There are two tiers of key in this project, with very different risk profiles.
#
# 1. TMDB — used by everyone who uses the app.
#    Ships in the published bundle and is readable by any visitor.
#
# 2. Barcode databases — for LOCAL TESTING ONLY.
#    Put these in `.env.development.local`, which `vite build` never reads and
#    the code additionally gates on `import.meta.env.DEV`. They must not reach
#    a deployed build: they are paid/limited API quotas.

# --- app-wide (goes in .env.local) -----------------------------------------
# Get a key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# --- local testing only (goes in .env.development.local) -------------------
# Leave blank to skip prefilling; you can still enter keys in Settings, or rely
# on UPCitemdb's keyless trial endpoint.
VITE_UPCMDB_API_KEY=
VITE_UPCDATABASE_API_KEY=
VITE_EANDATA_API_KEY=
VITE_UPCITEMDB_API_KEY=